# Нотион интеграция
# 1. Создай интеграцию: https://www.notion.so/my-integrations
# 2. Скопируй Internal Integration Token
NOTION_TOKEN=secret_ВАШ_ТОКЕН

# ID базы данных Notion для заявок (из URL страницы базы)
NOTION_DATABASE_ID=ccb7731b0d9646c8ad38f147d3f05db4

# ID базы данных Notion для блога (создай отдельную базу с полями: Заголовок, Slug, Описание, Контент, Обложка, Опубликовано, Дата)
# NOTION_BLOG_DATABASE_ID=ВАШ_ID_БАЗЫ_ДЛЯ_БЛОГА

# ID базы данных Notion для магазина (поля: Название, Slug, Категория, Цена, Старая цена, Описание, Цвета, Изображение, Фон, Всего единиц, Продано, Новинка, Дроп, Номер дропа, Статус)
# NOTION_SHOP_DATABASE_ID=ВАШ_ID_БАЗЫ_ДЛЯ_МАГАЗИНА

# Видео для страницы магазина (опционально)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.example.com/video.mp4
# NEXT_PUBLIC_HERO_POSTER_URL=https://cdn.example.com/poster.jpg

# SMTP для email-уведомлений (опционально)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=mail@svoboda.site
# SMTP_PASS=ваш_пароль_приложения
# FROM_EMAIL=mail@svoboda.site
# MANAGER_EMAIL=mail@svoboda.site

# Путь к SQLite (опционально, по умолчанию data/leads.db)
# DB_PATH=data/leads.db

# Секрет для подписи сессии CRM (/admin) — обязателен, сгенерировать один раз:
# openssl rand -hex 32
CRM_SESSION_SECRET=
